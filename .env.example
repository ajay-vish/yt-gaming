# YouTube Data API v3 OAuth Credentials (generated from scripts/setup_oauth.py)
YT_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
YT_CLIENT_SECRET=your_client_secret_here
YT_REFRESH_TOKEN=your_refresh_token_here

# Google Gemini API Key (for automated viral title, description, and hashtags)
GEMINI_API_KEY=your_gemini_api_key_here
